# =============================================================================
# WisePen 中间件环境变量（强密码模板）
# -----------------------------------------------------------------------------
# 用法：
#   方式 1 一键体验（弱默认 root/admin/nacos，仅限本地）：
#     执行 ../../scripts/middleware/init-up.sh local minimal 启动服务
#    （自动复制local-default.env）
#
#   方式 2 自填强密码：
#     cp env.example .env
#     编辑 .env，把所有 change-me / change-me-* 替换为强随机值
#     执行 ../../scripts/middleware/init-up.sh server full 启动服务
#
#   方式 3 自动生成强密码（推荐 server 形态）：
#     ../../scripts/envs/init-envs.sh --random-secrets
#     执行 ../../scripts/middleware/init-up.sh server full 启动服务
#
# 当 WISEPEN_BIND_ADDR != 127.0.0.1 时，init-up.sh / up.sh 都会扫描所有
# *PASSWORD/*SECRET/*TOKEN/*KEY 字段；如发现弱默认或 change-me 占位会立即退出
# =============================================================================

# ───────────────────────────────────────────────────────────────────────────
# 部署形态
# ───────────────────────────────────────────────────────────────────────────
# 中间件容器对宿主机暴露端口的绑定地址
# init-up.sh 会按 <bind> 参数自动写回此处
#   127.0.0.1  仅自机访问（本地形态，默认；安全）
#   0.0.0.0    对所有网卡暴露（开发服务器形态；外部可访问）
WISEPEN_BIND_ADDR=127.0.0.1

# 中间件栈
# init-up.sh 会按 <stack> 参数自动写回此处
#   minimal  核心中间件
#   full     minimal + jenkins + observability + search
MIDDLEWARE_STACK=minimal

# 公开宿主名（Kafka EXTERNAL listener 通告给外部 producer/consumer 的 host）
# - 本机 docker compose 起：localhost
# - 开发服务器：填该服务器的 DNS 名或公网 IP（如 wisepen-dev.example.com）
WISEPEN_PUBLIC_HOST=localhost

# 子网（避免与已有 docker network 冲突时调整）
WISEPEN_NET_SUBNET=172.28.0.0/16

# 数据卷根目录（可选，绝对路径）：
#   留空 → 使用 docker named volumes（不污染仓库目录、跨机迁移用 docker volume cp）
#   填写 → up.sh 自动叠加 profiles/bind-data*.yml，把数据落到该目录下并 mkdir+chown
# WISEPEN_DATA_ROOT=/srv/wisepen

# ───────────────────────────────────────────────────────────────────────────
# 基础存储层
# ───────────────────────────────────────────────────────────────────────────
WISEPEN_MYSQL_PASSWORD=change-me-mysql
WISEPEN_MYSQL_HOST_PORT=3306

WISEPEN_REDIS_PASSWORD=change-me-redis
WISEPEN_REDIS_HOST_PORT=6379

WISEPEN_MONGO_USER=root
WISEPEN_MONGO_PASSWORD=change-me-mongo
WISEPEN_MONGO_HOST_PORT=27017

# ───────────────────────────────────────────────────────────────────────────
# Nacos
# ───────────────────────────────────────────────────────────────────────────
# Token 必须是 Base64 编码、长度 > 32 字符
# 示例值仅供占位，部署前请改为强随机值
NACOS_AUTH_TOKEN=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtY2hhbmdlLW1lLWNoYW5nZS1tZQ==
# Nacos 控制台账号 + 密码
# up.sh 首次起 Nacos 时会先尝试 NACOS_USERNAME / NACOS_PASSWORD 登入
# 若失败则用 Nacos 出厂默认 nacos/nacos 登入并 PUT 改成 NACOS_PASSWORD
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos

WISEPEN_NACOS_HOST_PORT=8848
WISEPEN_NACOS_GRPC_HOST_PORT=9848

# ───────────────────────────────────────────────────────────────────────────
# APISIX 网关 + etcd + Dashboard
# ───────────────────────────────────────────────────────────────────────────
ETCD_ROOT_PASSWORD=change-me-etcd

APISIX_HTTP_PORT=80
APISIX_HTTPS_PORT=443
APISIX_ADMIN_HOST_PORT=9180
APISIX_DASHBOARD_HOST_PORT=9000

# APISIX Admin API key
# 这把 key 也是 wisepen-cloud-gateway-deploy/setup.sh 推送路由时使用的凭证
APISIX_ADMIN_KEY=change-me-apisix-admin-key

APISIX_DASHBOARD_USER=admin
APISIX_DASHBOARD_PASSWORD=change-me-dashboard
# JWT 签名密钥
APISIX_DASHBOARD_SECRET=change-me-dashboard-jwt-secret

# ───────────────────────────────────────────────────────────────────────────
# Kafka
# ───────────────────────────────────────────────────────────────────────────
KAFKA_INTERNAL_HOST_PORT=9092
KAFKA_EXTERNAL_HOST_PORT=9094
KAFKA_UI_HOST_PORT=9091
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=change-me-kafka-ui

# ───────────────────────────────────────────────────────────────────────────
# Qdrant
# ───────────────────────────────────────────────────────────────────────────
WISEPEN_QDRANT_API_KEY=change-me-qdrant
WISEPEN_QDRANT_HOST_PORT=6333
WISEPEN_QDRANT_GRPC_HOST_PORT=6334

# ───────────────────────────────────────────────────────────────────────────
# JODConverter
# ───────────────────────────────────────────────────────────────────────────
WISEPEN_JOD_HOST_PORT=8100

# ───────────────────────────────────────────────────────────────────────────
# 跨服务安全 token
# ───────────────────────────────────────────────────────────────────────────
# 网关 → 微服务 的来源校验 token；wisepen-cloud / wisepen-cloud-sidecar / 网关都用这个
FROM_SOURCE_SECRET=change-me-from-source-secret

# ───────────────────────────────────────────────────────────────────────────
# Jenkins (随 stack=full 启动；stack=minimal 不起 Jenkins)
# ───────────────────────────────────────────────────────────────────────────
JENKINS_HTTP_HOST_PORT=8080
JENKINS_AGENT_HOST_PORT=50000
JENKINS_JAVA_OPTS="-Xms512m -Xmx1024m"

# 自动创建的 admin 账号（无 setup wizard）
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-jenkins-admin

# Job DSL seed 用的源码仓库基址（拼接成 ${JENKINS_SCM_BASE_URL}/wisepen-cloud.git 等）
# 例：https://github.com/your-org   或者   git@github.com:your-org
JENKINS_SCM_BASE_URL=https://github.com/Oriole-FDU

# 拉取源码的凭证（GitHub PAT、企业 Git 用户名密码等）
# 没有 PAT 时填空字符串，但凭据存在 Jenkins 后才能 build
JENKINS_SCM_CRED_USER=your-scm-user
JENKINS_SCM_CRED_TOKEN=change-me-scm-token

# Pipeline 跑 build / deploy 时连 Nacos 用的凭据
JENKINS_NACOS_USERNAME=nacos
JENKINS_NACOS_PASSWORD=change-me-nacos

# ───────────────────────────────────────────────────────────────────────────
# 可选 profile 用变量
# ───────────────────────────────────────────────────────────────────────────
# observability profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_HOST_PORT=3000
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_PROMETHEUS_EXPORT_HOST_PORT=8889
TEMPO_HOST_PORT=3200
LOKI_HOST_PORT=3100

# search profile
ES_ELASTIC_PASSWORD=change-me-es
ES_HOST_PORT=9200
ES_TRANSPORT_HOST_PORT=9300
KIBANA_HOST_PORT=5601
ES_JAVA_OPTS="-Xms512m -Xmx512m"
