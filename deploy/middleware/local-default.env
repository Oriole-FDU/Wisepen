# =============================================================================
# WisePen 中间件 — 本地一键体验默认值
# -----------------------------------------------------------------------------
# 仅当 deploy/middleware/.env 不存在时，scripts/middleware/init-up.sh local <stack>
# 会自动把这个文件复制成 .env
# 任何对外暴露（WISEPEN_BIND_ADDR=0.0.0.0）的部署都必须改成强随机值
# =============================================================================

# ── 部署形态 ────────────────────────────────────────────
WISEPEN_BIND_ADDR=127.0.0.1
MIDDLEWARE_STACK=minimal
WISEPEN_PUBLIC_HOST=localhost
WISEPEN_NET_SUBNET=172.28.0.0/16

# ── 数据卷（可选）─ 留空走 named volume ──────────────────
# WISEPEN_DATA_ROOT=/srv/wisepen

# ── 基础存储层 ──────────────────────────────────────────
WISEPEN_MYSQL_PASSWORD=root
WISEPEN_MYSQL_HOST_PORT=3306

WISEPEN_REDIS_PASSWORD=root
WISEPEN_REDIS_HOST_PORT=6379

WISEPEN_MONGO_USER=root
WISEPEN_MONGO_PASSWORD=root
WISEPEN_MONGO_HOST_PORT=27017

# ── Nacos ───────────────────────────────────────────────
# Token 必须 base64 + 长度 > 32；这里用一个固定的本地占位
NACOS_AUTH_TOKEN=JER5VzhIZ3ZwcjJ6c21kYUBQIUdzVmZ4OCE1XndzVDI=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

WISEPEN_NACOS_HOST_PORT=8848
WISEPEN_NACOS_GRPC_HOST_PORT=9848

# ── APISIX 网关 + etcd + Dashboard ──────────────────────
ETCD_ROOT_PASSWORD=root

APISIX_HTTP_PORT=80
APISIX_HTTPS_PORT=443
APISIX_ADMIN_HOST_PORT=9180
APISIX_DASHBOARD_HOST_PORT=9000

APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

APISIX_DASHBOARD_USER=admin
APISIX_DASHBOARD_PASSWORD=admin
APISIX_DASHBOARD_SECRET=$DyW8Hgvpr2zsmda@P!GsVfx8!5^wsT2

# ── Kafka ───────────────────────────────────────────────
KAFKA_INTERNAL_HOST_PORT=9092
KAFKA_EXTERNAL_HOST_PORT=9094
KAFKA_UI_HOST_PORT=9091
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=admin

# ── Qdrant ──────────────────────────────────────────────
WISEPEN_QDRANT_API_KEY=root
WISEPEN_QDRANT_HOST_PORT=6333
WISEPEN_QDRANT_GRPC_HOST_PORT=6334

# ── JODConverter ────────────────────────────────────────
WISEPEN_JOD_HOST_PORT=8100

# ── 跨服务安全 token ────────────────────────────────────
FROM_SOURCE_SECRET=APISIX-wX0iR6tY

# ── Jenkins ─────────────────────────────────────────────
JENKINS_HTTP_HOST_PORT=8080
JENKINS_AGENT_HOST_PORT=50000
JENKINS_JAVA_OPTS="-Xms512m -Xmx1024m"

JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin

# 默认指向 GitHub 仓库；https://github.com/Oriole-FDU/
JENKINS_SCM_BASE_URL=https://github.com/Oriole-FDU/

JENKINS_SCM_CRED_USER=
JENKINS_SCM_CRED_TOKEN=

JENKINS_NACOS_USERNAME=nacos
JENKINS_NACOS_PASSWORD=nacos

# ── observability profile ──────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST_PORT=3000
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_PROMETHEUS_EXPORT_HOST_PORT=8889
TEMPO_HOST_PORT=3200
LOKI_HOST_PORT=3100

# ── search profile ─────────────────────────────────────
ES_ELASTIC_PASSWORD=admin
ES_HOST_PORT=9200
ES_TRANSPORT_HOST_PORT=9300
KIBANA_HOST_PORT=5601
ES_JAVA_OPTS="-Xms512m -Xmx512m"
