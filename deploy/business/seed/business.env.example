# =============================================================================
# deploy/business/seed/business.env.example
# -----------------------------------------------------------------------------
# 业务"种子凭据 + 业务系统配置"。
# 本文件只在 scripts/middleware/seed.sh 渲染期被读取一次
# 不进入任何容器环境
#
# 用法：
#   cp business.env.example business.env
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# [1] 业务凭据段：LLM provider（mongo wisepen_chat.wisepen_providers）
# -----------------------------------------------------------------------------
# 仓库默认且仅默认 zhizengzeng（智增增）—— wisepen_model_provider_mappings 内
# 14 条映射全部硬编码指向智增增的 ObjectId。**想换 provider 必须自己进 mongo
# wisepen_chat 库重做整张 wisepen_model_provider_mappings**，详见 README。
# 本段为空 → 整段 INSERT 跳过；chat-service 调模型时报错。
# ─────────────────────────────────────────────────────────────────────────────
WISEPEN_LLM_PROVIDER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# [2] 业务凭据段：主存储（mysql wisepen_system.sys_storage_config）
# -----------------------------------------------------------------------------
# 默认 ALIYUN_OSS。本仓库后端目前只实现了 ALIYUN_OSS 一种 provider，
# MINIO / TENCENT_COS 等暂未实现，请勿改 provider 字段。
# 本段为空或不填写WISEPEN_OSS_ACCESS_KEY_SECRET → 整段 INSERT 跳过；file-storage-service 上传/下载报错。
# ─────────────────────────────────────────────────────────────────────────────
WISEPEN_OSS_REGION=                 # 例 cn-hangzhou
WISEPEN_OSS_ENDPOINT=               # 例 https://oss-cn-hangzhou.aliyuncs.com（容器内联通可用 -internal 域名）
WISEPEN_OSS_ACCESS_KEY_ID=
WISEPEN_OSS_ACCESS_KEY_SECRET=
WISEPEN_OSS_BUCKET_NAME=
WISEPEN_OSS_DOMAIN=                 # 可空：CDN / 直连域名；不填则由 SDK 用 endpoint+bucket 拼
WISEPEN_OSS_ROLE_ARN=               # 可空：STS Token 用

# ─────────────────────────────────────────────────────────────────────────────
# [3] 业务系统配置段：LLM 默认网关 + Memory / Summary 模型
# -----------------------------------------------------------------------------
# 写入 nacos yaml：deploy/business/seed/nacos/wisepen-chat-service-{dev,prod}.yaml
# chat-service（Python）依赖的 Mem0 长期记忆 + 摘要模型名。
# 本段为空或不完全填写 → chat-service 调模型时报错。
# ─────────────────────────────────────────────────────────────────────────────
# LLM 默认网关（chat-service 直连）。通常和 [1] 的 WISEPEN_LLM_PROVIDER_API_KEY 同值。
LLM_BASE_URL=https://api.zhizengzeng.com/v1
LLM_API_KEY=

# Memory（Mem0 子模块用；缺一不可）
MEMORY_LLM_MODEL=                    # 例 gpt-4o-mini
MEMORY_EMBEDDING_MODEL=              # 例 text-embedding-3-small
MEMORY_RERANKER_ZE_MODEL=            # 例 zerank-1（ZeroEntropy 模型名）
ZERO_ENTROPY_API_KEY=                # 可空；不用 reranker 留空即可

# Summary（会话摘要 / 标题生成）
SUMMARY_MODEL=                       # 例 gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# [4] 业务系统配置段：邮件（SMTP）
# -----------------------------------------------------------------------------
# 写入 nacos yaml：deploy/business/seed/nacos/wisepen-system-service-{dev,prod}.yaml
# system-service（Java）忘密码 / 邀请等场景发邮件用。
# 本段为空或不完全填写 → system-service 发邮件时报错。
# ─────────────────────────────────────────────────────────────────────────────
WISEPEN_MAIL_HOST=                   # 例 smtp.qq.com / smtp.exmail.qq.com / smtp.gmail.com
WISEPEN_MAIL_USERNAME=               # 发件邮箱完整地址
WISEPEN_MAIL_PASSWORD=               # SMTP 授权码（非邮箱登录密码）
# WISEPEN_MAIL_PORT=465              # 默认 465 SSL；可不显式声明
