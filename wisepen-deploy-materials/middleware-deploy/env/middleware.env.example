# 全局部署
TZ=Asia/Shanghai
MIDDLEWARE_DATA_DIR=/opt/wisepen/middleware-data
CUSTOM_FONTS_DIR=/opt/wisepen/fonts
WISEPEN_NETWORK_NAME=wisepen-net
WISEPEN_NETWORK_SUBNET=172.28.0.0/16
PUBLIC_BIND_HOST=0.0.0.0
MIDDLEWARE_BIND_HOST=127.0.0.1

# MySQL
MYSQL_ROOT_PASSWORD=

# Redis
REDIS_PASSWORD=

# MongoDB
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=

# Nacos 数据库
NACOS_DB_NAME=nacos
NACOS_DB_USERNAME=nacos
NACOS_DB_PASSWORD=

# Nacos 登录与服务端鉴权
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_AUTH_TOKEN=
NACOS_IDENTITY_KEY=
NACOS_IDENTITY_VALUE=

# etcd 与 APISIX
ETCD_ROOT_USERNAME=root
ETCD_ROOT_PASSWORD=
APISIX_ADMIN_KEY=
APISIX_DASHBOARD_USER=admin
APISIX_DASHBOARD_PASSWORD=
APISIX_DASHBOARD_SECRET=

# Elasticsearch / Qdrant
ES_ELASTIC_PASSWORD=
QDRANT_API_KEY=

# 可观测性
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# 管理工具
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=

# OnlyOffice
ONLYOFFICE_JWT_SECRET=

# MinerU
# 仅在组合 compose/mineru.yaml 时填写
MINERU_IMAGE=
MINERU_MODEL_DIR=/opt/wisepen/models/mineru
MINERU_OUTPUT_DIR=/opt/wisepen/middleware-data/mineru/output
MINERU_GPU_DEVICE_ID=0
MINERU_GPU_MEMORY_UTILIZATION=0.8
MINERU_MAX_CONCURRENT_REQUESTS=1

# Kafka 外部访问
KAFKA_EXTERNAL_HOST=
KAFKA_EXTERNAL_PORT=9094
KAFKA_EXTERNAL_BIND_HOST=0.0.0.0

# 可选宿主机端口覆盖
# MYSQL_HOST_PORT=3306
# REDIS_HOST_PORT=6379
# MONGO_HOST_PORT=27017
# NACOS_HTTP_HOST_PORT=8848
# NACOS_GRPC_HOST_PORT=9848
