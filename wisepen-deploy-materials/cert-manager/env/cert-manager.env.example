# 容器时区与 WisePen 共享 Docker 网络名称
TZ=Asia/Shanghai
WISEPEN_NETWORK_NAME=wisepen-net

# acme.sh 持久化目录，保存 ACME 账号私钥、签发订单和证书
CERT_MANAGER_DATA_DIR=/opt/wisepen/cert-manager

# ACME 与证书域名
# new：目录中没有该主域名证书时执行注册和签发
# existing：目录中已有对应证书配置
CERT_STATE_SOURCE=new

# 当前仅允许 zerossl 或 letsencrypt
# 邮箱用于注册 ACME 账号和接收到期通知
ACME_CA=zerossl
ACME_EMAIL=

# 主证书域名，例如 wisepen.example.com；通配符开启后自动追加 *.wisepen.example.com
CERT_PRIMARY_DOMAIN=
CERT_APPLY_WILDCARD=true
# 额外 SAN 域名使用逗号分隔，不含主域名和自动生成的通配符域名
CERT_EXTRA_DOMAINS=

# AliDNS DNS-01 验证凭据
ALIDNS_ACCESS_KEY_ID=
ALIDNS_ACCESS_KEY_SECRET=

# APISIX 分发
# 开启后，续期 Hook 将证书写入指定 APISIX SSL 资源；SNI 使用逗号分隔
DISTRIBUTE_TO_APISIX=true
APISIX_ADMIN_URL=http://apisix:9180
APISIX_ADMIN_KEY=
APISIX_SSL_ID=wisepen-cert-manager
# 逗号分隔，仅填写实际由 APISIX 提供 HTTPS 的域名
APISIX_TLS_SNIS=

# 主前端 OSS 分发
# 开启后必须填写本组独立凭据、Endpoint、Bucket 和 CNAME 域名
DISTRIBUTE_TO_FRONTEND_OSS=false
FRONTEND_OSS_ACCESS_KEY_ID=
FRONTEND_OSS_ACCESS_KEY_SECRET=
FRONTEND_OSS_ENDPOINT=
FRONTEND_OSS_BUCKET=
FRONTEND_OSS_DOMAIN=

# DrawIO OSS 分发
# 开启后必须填写本组独立凭据、Endpoint、Bucket 和 CNAME 域名
DISTRIBUTE_TO_DRAWIO_OSS=false
DRAWIO_OSS_ACCESS_KEY_ID=
DRAWIO_OSS_ACCESS_KEY_SECRET=
DRAWIO_OSS_ENDPOINT=
DRAWIO_OSS_BUCKET=
DRAWIO_OSS_DOMAIN=
